{
    "version": 2,
    "builds": [
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/v1/(.*)",
            "destination": "/backend/server.js"
        },
        {
            "source": "/(.*)\\.(.*)",
            "destination": "/frontend/$1.$2"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/index.html"
        }
    ]
}